# Copy to .env and replace every changeme value before starting Compose.
POSTGRES_DB=house_price
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres
MIGRATION_PASSWORD=changeme-migration
PIPELINE_PASSWORD=changeme-pipeline
GRAFANA_PASSWORD=changeme-grafana
DATABASE_URL=postgresql+psycopg://pipeline_writer:changeme-pipeline@postgres:5432/house_price
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:changeme-migration@postgres:5432/house_price
OPTUNA_STORAGE_URL=postgresql+psycopg://pipeline_writer:changeme-pipeline@postgres:5432/optuna
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://postgres:changeme-postgres@postgres:5432/mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow-artifacts
MODEL_REGISTRY_PATH=/model-registry
DATASET_PATH=/app/data/california_housing.parquet
DATASET_MANIFEST_PATH=/app/data/dataset-manifest.json
ENVIRONMENT_VERSION=local-dev
TRAINING_ENVIRONMENT_VERSION=local-dev
CODE_REVISION=local-dev
LOG_LEVEL=INFO
POSTGRES_HOST_PORT=5432
MLFLOW_HOST_PORT=5000
INFERENCE_HOST_PORT=8000

